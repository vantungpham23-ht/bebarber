{
  "name": "be-dat-lich",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "next dev -p 3000",
    "dev:kill": "sh -c 'for p in 3000 3001 3002 3003; do lsof -ti:$p | xargs kill -9 2>/dev/null || true; done; exec next dev -p 3000'",
    "dev:fresh": "sh -c 'npm run clean; for p in 3000 3001 3002 3003; do lsof -ti:$p | xargs kill -9 2>/dev/null || true; done; exec next dev -p 3000'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npm run build && npx @cloudflare/next-on-pages",
    "pages:preview": "npx wrangler pages dev .vercel/output/static --compatibility-date=2024-12-01"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.15",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "wrangler": "^3.91.0"
  }
}
